# sf-meter-api 環境変数テンプレート
# .env.example をコピーして .env として使用してください
# .env は .gitignore に含まれています

# PostgreSQL接続文字列（未設定ならメモリ実装で動きます）
DATABASE_URL=postgres://sfmeter:sfmeter@localhost:5432/sfmeter_db?sslmode=disable

# サーバーポート（デフォルト: 8080）
PORT=8080

# 追加・更新・削除に使うトークン。未設定なら、書き込みの API は閉じたままになります
# 値は自分で決めた長い文字列にしてください（例: openssl rand -hex 32）
ADMIN_TOKEN=

# ブラウザーから API を呼んでよいオリジン（カンマ区切り）
# 未設定なら、Vite の開発サーバー（http://localhost:5173）だけを許します
# CORS_ALLOWED_ORIGINS=https://example.com
